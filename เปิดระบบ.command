#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

echo "========================================================"
echo "📋 Team TaskFlow - ระบบจัดการงานทีม"
echo "========================================================"
echo "💡 หากต้องการให้งานในคอมพิวเตอร์และโทรศัพท์มือถือซิงค์กัน:"
echo "   กรุณาเปิดผ่านลิงก์ Cloudflare Pages ของคุณ (เช่น https://....pages.dev)"
echo "   (การเปิดผ่านไฟล์นี้ จะบันทึกเฉพาะในเครื่องคอมพิวเตอร์นี้เท่านั้น)"
echo "========================================================"
echo "กำลังเปิดหน้าเว็บในเบราว์เซอร์ของคุณ..."
open "$DIR/index.html"
